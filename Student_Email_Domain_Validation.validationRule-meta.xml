<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Student_Email_Domain_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(CONTAINS(Email__c, "@student.edu"))</errorConditionFormula>
    <errorMessage>Email must be a valid student institutional email.</errorMessage>
</ValidationRule>
